# Node 2 Main Application Configuration
# Copy to .env and fill in values

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# Node 1 Inference Server (RTX 2060 machine)
# Easy to update: just change this IP when network changes
NODE1_URL=http://192.168.0.103:8001
INFERENCE_TIMEOUT=60

# Server Configuration
HOST=0.0.0.0
PORT=8000

# NVIDIA API (for synthetic data generation)
GEMINI_API_KEY=your-gemini-api-key-here
